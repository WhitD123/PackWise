# Packwise environment variables. Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio key for the photo scan (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: which Gemini model reads the photo. Default is set in src/lib/scan/config.ts.
# GEMINI_MODEL=gemini-3.1-flash-lite
